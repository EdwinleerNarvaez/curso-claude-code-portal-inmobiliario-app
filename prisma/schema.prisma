// Esquema de Prisma para PostgreSQL.
// La URL de conexión se configura en prisma.config.ts (variable DATABASE_URL).
// Convenciones: .claude/skills/prisma-rules/SKILL.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN

  @@map("role")
}

enum OperationType {
  SALE
  RENT

  @@map("operation_type")
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  OFFICE
  COMMERCIAL
  OTHER

  @@map("property_type")
}

enum Currency {
  USD

  @@map("currency")
}

// ---------------------------------------------------------------------------
// Usuarios
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  favorites Favorite[]
  inquiries Inquiry[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Propiedades
// ---------------------------------------------------------------------------

model Property {
  id            String        @id @default(uuid(7)) @db.Uuid
  title         String
  description   String
  operationType OperationType @map("operation_type")
  propertyType  PropertyType  @map("property_type")
  price         Decimal       @db.Decimal(14, 2)
  currency      Currency      @default(USD)
  // Opcionales: no aplican a todos los tipos de propiedad (por ejemplo, terrenos).
  usableArea    Decimal?      @map("usable_area") @db.Decimal(10, 2)
  totalArea     Decimal?      @map("total_area") @db.Decimal(10, 2)
  bedrooms      Int?
  bathrooms     Int?
  parkingSpaces Int?          @map("parking_spaces")
  ageInYears    Int?          @map("age_in_years")
  // Ubicación textual: no se solicitan latitud ni longitud.
  address       String
  commune       String
  city          String
  region        String
  isPublished   Boolean       @default(false) @map("is_published")
  isFeatured    Boolean       @default(false) @map("is_featured")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  images    PropertyImage[]
  features  PropertyFeature[]
  favorites Favorite[]
  inquiries Inquiry[]

  // Consultas públicas del catálogo: siempre filtran por publicadas.
  @@index([isPublished, operationType, propertyType])
  @@index([isPublished, isFeatured])
  @@index([isPublished, createdAt])
  @@index([isPublished, price])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  url        String
  publicId   String   @unique @map("public_id")
  position   Int      @default(0)
  isMain     Boolean  @default(false) @map("is_main")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Cascade: las imágenes no existen sin su propiedad. El servicio elimina
  // primero los archivos en Cloudinary para no dejar referencias huérfanas.
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
  @@map("property_images")
}

// ---------------------------------------------------------------------------
// Características
// ---------------------------------------------------------------------------

model Feature {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  properties PropertyFeature[]

  @@map("features")
}

model PropertyFeature {
  propertyId String   @map("property_id") @db.Uuid
  featureId  String   @map("feature_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  // Cascade en ambos lados: la asociación no tiene sentido sin la propiedad o
  // sin la característica.
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  feature  Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([propertyId, featureId])
  @@index([featureId])
  @@map("property_features")
}

// ---------------------------------------------------------------------------
// Favoritos
// ---------------------------------------------------------------------------

model Favorite {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  // Cascade: un favorito no tiene sentido sin su usuario o su propiedad.
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@map("favorites")
}

// ---------------------------------------------------------------------------
// Consultas (solicitudes de información)
// ---------------------------------------------------------------------------

model Inquiry {
  id            String   @id @default(uuid(7)) @db.Uuid
  // Opcional y SetNull: si se elimina la propiedad, la consulta se conserva y
  // mantiene el título guardado al momento de enviarla.
  propertyId    String?  @map("property_id") @db.Uuid
  propertyTitle String   @map("property_title")
  // Opcional: los visitantes no autenticados también pueden consultar.
  userId        String?  @map("user_id") @db.Uuid
  name          String
  email         String
  phone         String?
  message       String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([userId])
  @@index([createdAt])
  @@map("inquiries")
}
