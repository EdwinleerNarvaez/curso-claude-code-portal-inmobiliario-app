# Copia este archivo como .env.local y completa los valores.
# Variables del frontend (@portal/web).
# Solo las variables con prefijo NEXT_PUBLIC_ quedan expuestas al navegador.

# --- Backend ---
# URL de @portal/api. Solo la usa el servidor de Next.js para reenviar /api/*.
API_URL=http://localhost:3001

# --- Aplicación ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Maps ---
# Clave restringida por dominio (HTTP referrer) en Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
