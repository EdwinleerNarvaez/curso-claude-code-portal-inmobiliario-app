# Copia este archivo como .env.local y completa los valores.
# Variables del backend (@portal/api): todas son secretas y solo se usan en el servidor.

# --- PostgreSQL (contenedor Docker publicado en el puerto 5433) ---
DATABASE_URL=postgresql://usuario:contrasena@localhost:5433/portal_inmobiliario?schema=public

# --- Autenticación ---
# Genera un valor aleatorio largo, por ejemplo: openssl rand -base64 32
AUTH_SECRET=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Web3Forms ---
WEB3FORMS_ACCESS_KEY=
