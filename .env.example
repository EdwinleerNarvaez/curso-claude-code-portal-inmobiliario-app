# Copia este archivo como .env.local y completa los valores.
# Nunca subas secretos reales al repositorio.
# Solo las variables con prefijo NEXT_PUBLIC_ quedan expuestas al navegador.

# --- Aplicación ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- PostgreSQL (contenedor Docker publicado en el puerto 5433) ---
DATABASE_URL=postgresql://usuario:contrasena@localhost:5433/portal_inmobiliario?schema=public

# --- Autenticación (solo servidor) ---
# Genera un valor aleatorio largo, por ejemplo: openssl rand -base64 32
AUTH_SECRET=

# --- Cloudinary (solo servidor) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Maps ---
# Clave restringida por dominio (HTTP referrer) en Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Web3Forms (solo servidor) ---
WEB3FORMS_ACCESS_KEY=
