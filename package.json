{
  "name": "portal-inmobiliario",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run db:generate -w @portal/api",
    "db:migrate": "npm run db:migrate -w @portal/api --",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @portal/api",
    "db:migrate:status": "npm run db:migrate:status -w @portal/api",
    "db:check": "npm run db:check -w @portal/api",
    "db:seed": "npm run db:seed -w @portal/api"
  },
  "devDependencies": {
    "turbo": "2.11.13"
  }
}
